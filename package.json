{
  "name": "node-huckleberry-mcp",
  "version": "0.1.0",
  "description": "Node.js MCP server for Huckleberry child care app",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "node-huckleberry-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "dev": "node --loader tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "huckleberry",
    "child-care"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "firebase": "^10.8.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
